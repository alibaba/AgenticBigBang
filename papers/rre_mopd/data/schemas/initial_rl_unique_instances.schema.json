{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Initial RL unique instance manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": ["anon_instance_id", "category", "initial_rl_record_count"],
  "properties": {
    "anon_instance_id": {"type": "string", "pattern": "^TRN-[0-9A-F]{16}$"},
    "category": {"type": "string", "enum": ["A", "B", "C"]},
    "initial_rl_record_count": {"type": "integer", "minimum": 1}
  }
}
