{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Initial RL training record manifest row",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "anon_record_id",
    "anon_instance_id",
    "category",
    "training_phase",
    "record_occurrence"
  ],
  "properties": {
    "anon_record_id": {"type": "string", "pattern": "^REC-[0-9A-F]{16}$"},
    "anon_instance_id": {"type": "string", "pattern": "^TRN-[0-9A-F]{16}$"},
    "category": {"type": "string", "enum": ["A", "B", "C"]},
    "training_phase": {"type": "string", "const": "initial_expert_rl"},
    "record_occurrence": {"type": "integer", "minimum": 1}
  }
}
